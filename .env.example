# Where the SQLite file lives. Mount a persistent volume here in production.
DATABASE_PATH=./data/skills.db

# Public base URL, used for absolute links in /skills/[slug]/install.md and metadata.
SITE_URL=http://localhost:3000

# Single operator login for /admin. Admin is disabled until all three are set.
ADMIN_USERNAME=operator
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Sample fixtures are hidden in production unless this is "true".
SHOW_SAMPLES=false
